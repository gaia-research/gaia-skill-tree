{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaiaskilltree.com/schema/steward-credential-verification-receipt-v1.json",
  "title": "Steward credential verification receipt (v1)",
  "description": "Written only by the lead's integrate step at founder/steward/security-dispositions/receipts/<receiptId>.json, from the Steward ledger's agent.verify outcome for the credential_review dispatch that produced the records. The consumer accepts a record's verifiedBy only when a receipt like this names the same verifier, a different builder, the same file's review debt, and the record's reviewed-content hash.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "receiptId",
    "action",
    "outcome",
    "dispatchRule",
    "reviewDebtId",
    "builderAgentId",
    "verifierAgentId",
    "recordedAt",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "steward-credential-verification-receipt-v1"
    },
    "receiptId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "description": "Equals the file name stem."
    },
    "action": {
      "const": "agent.verify"
    },
    "outcome": {
      "const": "verified"
    },
    "dispatchRule": {
      "const": "credential-review-disposition"
    },
    "reviewDebtId": {
      "type": "string",
      "pattern": "^debt:credential_review:[a-z0-9-]+:[0-9a-f]{16}$"
    },
    "builderAgentId": {
      "type": "string",
      "minLength": 1
    },
    "verifierAgentId": {
      "type": "string",
      "minLength": 1,
      "description": "Must differ from builderAgentId."
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "Reviewed-content sha256 of each record this verification covers."
    }
  }
}
