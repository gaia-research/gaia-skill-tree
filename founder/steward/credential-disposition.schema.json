{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaiaskilltree.com/schema/steward-credential-disposition-v1.json",
  "title": "Steward credential disposition record",
  "description": "One independently verified disposition for one credential-shaped finding (#2283). Stored at founder/steward/security-dispositions/<debt-short-id>-<line>-<fingerprint>.json. The consumer (src/gaia_cli/steward/credentialDispositions.py) additionally requires verifiedBy to differ from author, and the ruling and policy decision records to be decided.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion", "debtId", "path", "line", "pattern", "fingerprint", "fileSha256", "policy",
    "disposition", "evidence", "author", "verifiedBy", "verifiedAt", "founderRuling"
  ],
  "properties": {
    "schemaVersion": {"const": "steward-credential-disposition-v1"},
    "debtId": {"type": "string", "pattern": "^debt:credential_leak:[a-z0-9-]+:[0-9a-f]{16}$"},
    "path": {"type": "string", "minLength": 1},
    "line": {"type": "integer", "minimum": 1},
    "pattern": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{12}$"},
    "fileSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the exact file bytes reviewed; any change voids the record."},
    "policy": {"enum": ["D1", "D2", "D3"]},
    "disposition": {"enum": ["synthetic-fixture", "mirror", "harmless-pattern", "runtime-header-construction"]},
    "evidence": {
      "oneOf": [
        {"type": "string", "minLength": 20},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 20}}
      ]
    },
    "author": {"type": "string", "minLength": 1},
    "verifiedBy": {"type": "string", "minLength": 1, "description": "Independent verifier id, distinct from author."},
    "verifiedAt": {"type": "string", "format": "date-time"},
    "founderRuling": {"const": "steward-credential-reconciliation-2283"}
  }
}
