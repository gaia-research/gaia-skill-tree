{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaiaskilltree.com/schema/agent-playbook-v1.json",
  "title": "Gaia agent playbook frontmatter",
  "type": "object",
  "required": [
    "name",
    "description",
    "playbookVersion",
    "class",
    "objective",
    "capability",
    "preconditions",
    "steps",
    "stopConditions",
    "proof",
    "done"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "playbookVersion": {
      "const": 1
    },
    "class": {
      "enum": ["A", "B", "C"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "preconditions": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "stopConditions": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "proof": {
      "$ref": "#/$defs/nonEmptyStringArray"
    },
    "done": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proofValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "proves": {
          "$ref": "#/$defs/proofValue"
        },
        "judgment": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["run", "proves"],
          "not": {
            "anyOf": [
              {"required": ["judgment"]},
              {"required": ["rules"]}
            ]
          }
        },
        {
          "required": ["judgment", "rules"],
          "not": {
            "anyOf": [
              {"required": ["run"]},
              {"required": ["proves"]}
            ]
          }
        }
      ]
    }
  }
}
