{
  "id": "prompt-caching",
  "name": "Prompt Caching",
  "type": "basic",
  "description": "Reuses a model's encoded prompt prefix or KV cache across repeated requests so identical long-context prefixes are not reprocessed, reducing latency and billed input tokens without serving a cached response or rewriting the prompt.",
  "prerequisites": [],
  "derivatives": [],
  "evidence": [
    {
      "source": "https://arxiv.org/abs/2312.07104",
      "evaluator": "mbtiongson1",
      "date": "2026-08-03",
      "type": "arxiv",
      "notes": "SGLang: Efficient Execution of Structured Language Model Programs introduces RadixAttention, which reuses common prompt prefixes/KV state across requests instead of re-encoding identical prefixes each time.",
      "citations": 36,
      "sourceStartedAt": "2023-12-12"
    },
    {
      "source": "https://arxiv.org/abs/2502.04677",
      "evaluator": "mbtiongson1",
      "date": "2026-08-03",
      "type": "arxiv",
      "notes": "LLM Query Scheduling with Prefix Reuse and Latency Constraints treats shared-prefix/KV reuse as a first-class serving objective, optimizing request scheduling around reusable prompt prefixes.",
      "citations": 0,
      "sourceStartedAt": "2025-02-07"
    },
    {
      "source": "https://arxiv.org/abs/2607.22648",
      "evaluator": "mbtiongson1",
      "date": "2026-08-03",
      "type": "arxiv",
      "notes": "PTStore (Prefix Tensor Store) focuses directly on distributed prefix caching and replication for high-throughput inference serving, treating reusable prompt prefixes as cached serving artifacts.",
      "citations": 0,
      "sourceStartedAt": "2026-06-25"
    }
  ],
