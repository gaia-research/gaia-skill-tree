{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gaia.arbor-benchmark-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "skill", "target", "benchmark", "control", "treatment", "provenance", "measurements"],
  "properties": {
    "schema": {"const": "gaia.arbor-benchmark-receipt/v1"},
    "skill": {"$ref": "#/definitions/skill"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declarationSha256", "claimId"],
      "properties": {
        "declarationSha256": {"$ref": "#/definitions/sha256"},
        "claimId": {"$ref": "#/definitions/recordId"}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/definitions/nonEmpty"},
        "version": {"$ref": "#/definitions/nonEmpty"}
      }
    },
    "control": {"$ref": "#/definitions/arm"},
    "treatment": {"$ref": "#/definitions/arm"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "observedAt", "artifacts"],
      "properties": {
        "runner": {"$ref": "#/definitions/nonEmpty"},
        "observedAt": {"type": "string", "format": "date-time"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "sha256"],
            "properties": {
              "uri": {"$ref": "#/definitions/nonEmpty"},
              "sha256": {"$ref": "#/definitions/sha256"}
            }
          }
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/measurement"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "recordId": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
    "skillId": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?(/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)?$"},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentSha256"],
      "properties": {
        "id": {"$ref": "#/definitions/skillId"},
        "contentSha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskSha256", "fixtureSha256", "evaluatorSha256"],
      "properties": {
        "taskSha256": {"$ref": "#/definitions/sha256"},
        "fixtureSha256": {"$ref": "#/definitions/sha256"},
        "evaluatorSha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "harness", "artifacts"],
      "properties": {
        "model": {"$ref": "#/definitions/nonEmpty"},
        "harness": {"$ref": "#/definitions/nonEmpty"},
        "artifacts": {"$ref": "#/definitions/artifacts"}
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "environment"],
      "properties": {
        "definition": {"$ref": "#/definitions/nonEmpty"},
        "environment": {"$ref": "#/definitions/environment"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number"},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "unit", "control", "treatment"],
      "properties": {
        "metric": {"$ref": "#/definitions/recordId"},
        "unit": {"$ref": "#/definitions/nonEmpty"},
        "control": {"$ref": "#/definitions/observation"},
        "treatment": {"$ref": "#/definitions/observation"},
        "difference": {"type": "number"}
      }
    }
  }
}
