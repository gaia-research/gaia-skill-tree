{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gaia.arbor-expert-declaration/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "skill", "claims"],
  "properties": {
    "schema": {"const": "gaia.arbor-expert-declaration/v1"},
    "skill": {"$ref": "#/definitions/skill"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/claim"}
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentSha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "contentSha256": {"$ref": "#/definitions/sha256"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "basis"],
      "properties": {
        "actor": {"$ref": "#/definitions/nonEmpty"},
        "basis": {"$ref": "#/definitions/nonEmpty"}
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "direction", "minimumEffect"],
      "properties": {
        "metric": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "direction": {"enum": ["increase", "decrease"]},
        "minimumEffect": {"type": "number", "minimum": 0}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "facet", "conditions", "rationale", "authority", "expectation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]*$"},
        "facet": {"enum": ["human-led", "model-led"]},
        "conditions": {"$ref": "#/definitions/nonEmpty"},
        "rationale": {"$ref": "#/definitions/nonEmpty"},
        "authority": {"$ref": "#/definitions/authority"},
        "expectation": {"$ref": "#/definitions/expectation"}
      }
    }
  }
}
